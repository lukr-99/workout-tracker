<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTracker.App.Pages.HistoryPage"
             Title="History">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Settings" Clicked="OnSettingsClicked" Priority="0" Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,20,20,0" RowSpacing="14">
        <VerticalStackLayout Spacing="4">
            <Label Text="Workout history" FontSize="26" FontAttributes="Bold" />
            <Label Text="Browse completed sessions, then narrow the list only when you need more detail." TextColor="{StaticResource Gray200}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" BackgroundColor="{StaticResource Gray950}" Padding="18">
            <VerticalStackLayout Spacing="12">
                <SearchBar Placeholder="Search workouts"
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding SearchCommand}" />
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Advanced filters"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleFiltersCommand}" />
                    <Label Text="{Binding ResultsSummary}"
                           VerticalOptions="Center"
                           TextColor="{StaticResource Gray200}" />
                </HorizontalStackLayout>
                <Border BackgroundColor="{StaticResource Gray900}"
                        Padding="14"
                        IsVisible="{Binding IsFiltersOpen}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Advanced filters" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Picker Grid.Column="0"
                                    Title="Workout type"
                                    ItemsSource="{Binding WorkoutTypes}"
                                    SelectedItem="{Binding SelectedWorkoutType}" />
                            <Picker Grid.Column="1"
                                    Title="Body part"
                                    ItemsSource="{Binding BodyParts}"
                                    SelectedItem="{Binding SelectedBodyPart}" />
                            <Button Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Text="Clear filters"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearFiltersCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Workouts}"
                        SelectionMode="None"
                        Margin="0,0,0,20">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource Gray900}" Padding="14" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding CompletedDateUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" TextColor="{StaticResource Gray200}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Open"
                                        Style="{StaticResource InlineActionButtonStyle}"
                                        VerticalOptions="Start"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenWorkoutCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                            <Label Text="{Binding SessionTypeLabel}" TextColor="{StaticResource Gray200}" />
                            <Label Text="{Binding BodyPartsSummary}" TextColor="{StaticResource Gray200}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="{Binding ExerciseCount, StringFormat='{}{0} exercises'}" />
                                <Label Grid.Column="1" Text="{Binding TotalVolumeKg, StringFormat='{}{0:N0} kg total volume'}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="0,32,0,0" Spacing="8">
                    <Label Text="No workouts found" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="Try a broader search or clear the active filters." TextColor="{StaticResource Gray200}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>
</ContentPage>
