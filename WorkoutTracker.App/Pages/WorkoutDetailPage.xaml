<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTracker.App.Pages.WorkoutDetailPage"
             Title="Workout Detail">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border BackgroundColor="{StaticResource Gray950}" Padding="18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding SessionHeader}" FontSize="22" FontAttributes="Bold" />
                    <Label Text="{Binding Notes}" TextColor="{StaticResource Gray200}" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Duplicate as template" Command="{Binding DuplicateAsTemplateCommand}" />
                        <Button Text="Start copy" Command="{Binding StartCopyCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource Gray900}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Progression summary" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding ProgressSummary}" />
                </VerticalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Entries}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource Gray900}" Padding="14" Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Subtitle}" TextColor="{StaticResource Gray200}" />
                                <CollectionView ItemsSource="{Binding Lines}" SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="{Binding .}" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
