<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTracker.App.Pages.ExerciseCatalogPage"
             Title="Catalog">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border BackgroundColor="{StaticResource Gray950}" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Exercise catalog" FontSize="22" FontAttributes="Bold" />
                    <SearchBar Placeholder="Search by name or body part"
                               Text="{Binding SearchText}"
                               SearchCommand="{Binding SearchCommand}" />
                    <HorizontalStackLayout Spacing="10">
                        <Picker Title="Body part" ItemsSource="{Binding BodyParts}" SelectedItem="{Binding SelectedBodyPart}" WidthRequest="170" />
                        <Picker Title="Category" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" WidthRequest="170" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Apply filters" Command="{Binding SearchCommand}" />
                        <Button Text="Sync wger" Command="{Binding SyncCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource Gray950}" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Create or edit custom exercise" FontSize="20" FontAttributes="Bold" />
                    <Entry Placeholder="Exercise name" Text="{Binding ExerciseName}" />
                    <Picker Title="Category" ItemsSource="{Binding Categories}" SelectedItem="{Binding EditorCategory}" />
                    <Entry Placeholder="Primary body part" Text="{Binding PrimaryBodyPart}" />
                    <Entry Placeholder="Secondary body parts (comma separated)" Text="{Binding SecondaryBodyParts}" />
                    <Entry Placeholder="Equipment" Text="{Binding Equipment}" />
                    <Editor Placeholder="Notes" AutoSize="TextChanges" Text="{Binding Notes}" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="New" Command="{Binding NewExerciseCommand}" />
                        <Button Text="Save" Command="{Binding SaveExerciseCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Exercises}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource Gray900}" Padding="14" Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout>
                                    <Label Text="{Binding Name}" FontAttributes="Bold" HorizontalOptions="StartAndExpand" />
                                    <Button Text="Edit"
                                            Style="{StaticResource InlineActionButtonStyle}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditExerciseCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding PrimaryBodyPart}" TextColor="{StaticResource Gray200}" />
                                <Label Text="{Binding Equipment}" TextColor="{StaticResource Gray200}" />
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Category}" HorizontalOptions="StartAndExpand" />
                                    <Button Text="Archive"
                                            Style="{StaticResource DangerInlineActionButtonStyle}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ArchiveExerciseCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
