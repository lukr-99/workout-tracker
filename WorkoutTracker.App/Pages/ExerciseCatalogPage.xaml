<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTracker.App.Pages.ExerciseCatalogPage"
             Title="Catalog">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Settings" Clicked="OnSettingsClicked" Priority="0" Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,20,20,0" RowSpacing="14">
        <VerticalStackLayout Spacing="4">
            <Label Text="Exercise catalog" FontSize="26" FontAttributes="Bold" />
            <Label Text="Keep the list readable, then open the editor only when you need to add or change an exercise." TextColor="{StaticResource Gray200}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" BackgroundColor="{StaticResource Gray950}" Padding="18">
            <VerticalStackLayout Spacing="12">
                <SearchBar Placeholder="Search by name, body part, or equipment"
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding SearchCommand}" />
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Advanced filters"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleAdvancedFiltersCommand}" />
                    <Button Text="Import public exercises"
                            Style="{StaticResource InlineActionButtonStyle}"
                            Command="{Binding SyncCommand}" />
                </HorizontalStackLayout>
                <Label Text="The public import uses wger, an open exercise database."
                       TextColor="{StaticResource Gray200}" />
                <Border BackgroundColor="{StaticResource Gray900}"
                        Padding="14"
                        IsVisible="{Binding IsAdvancedFiltersOpen}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Picker Grid.Column="0"
                                Title="Body part"
                                ItemsSource="{Binding BodyParts}"
                                SelectedItem="{Binding SelectedBodyPart}" />
                        <Picker Grid.Column="1"
                                Title="Category"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory}" />
                        <Button Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Text="Apply filters"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SearchCommand}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Exercises}"
                        SelectionMode="None"
                        Margin="0,0,0,20">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource Gray900}" Padding="14" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="{Binding BodyPartsSummary}" TextColor="{StaticResource Gray200}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Edit"
                                        Style="{StaticResource InlineActionButtonStyle}"
                                        VerticalOptions="Start"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditExerciseCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                            <Label Text="{Binding Equipment}" TextColor="{StaticResource Gray200}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Category}" VerticalOptions="Center" />
                                    <Label Text="Primary + secondary body parts shown together for multi-part work."
                                           TextColor="{StaticResource Gray300}"
                                           FontSize="12" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Archive"
                                        Style="{StaticResource DangerInlineActionButtonStyle}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ArchiveExerciseCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.RowSpan="3"
                Text="+"
                Style="{StaticResource FloatingActionButtonStyle}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,0,24"
                Command="{Binding NewExerciseCommand}" />

        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsEditorOpen}"
              BackgroundColor="#AA050709"
              Padding="20">
            <Border BackgroundColor="{StaticResource Gray950}"
                    Padding="18"
                    MaximumWidthRequest="520"
                    VerticalOptions="Center">
                <ScrollView>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="{Binding EditorTitle}" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="X"
                                    Style="{StaticResource OverlayDismissButtonStyle}"
                                    Command="{Binding CloseEditorCommand}" />
                        </Grid>
                        <Entry Placeholder="Exercise name" Text="{Binding ExerciseName}" />
                        <Picker Title="Category" ItemsSource="{Binding EditorCategories}" SelectedItem="{Binding EditorCategory}" />
                        <Picker Title="Primary body part"
                                ItemsSource="{Binding EditorBodyParts}"
                                SelectedItem="{Binding PrimaryBodyPart}" />
                        <Border BackgroundColor="{StaticResource Gray900}" Padding="14">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Secondary body parts" Style="{StaticResource FieldCaptionStyle}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Picker Grid.Column="0"
                                            Title="Add supporting body part"
                                            ItemsSource="{Binding EditorBodyParts}"
                                            SelectedItem="{Binding SelectedSecondaryBodyPart}" />
                                    <Button Grid.Column="1"
                                            Text="Add"
                                            Style="{StaticResource InlineActionButtonStyle}"
                                            Command="{Binding AddSecondaryBodyPartCommand}" />
                                </Grid>
                                <FlexLayout BindableLayout.ItemsSource="{Binding SelectedSecondaryBodyParts}"
                                            Direction="Row"
                                            Wrap="Wrap"
                                            IsVisible="{Binding HasSecondaryBodyParts}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SelectionChipStyle}">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="{Binding .}" VerticalOptions="Center" />
                                                    <Button Text="Remove"
                                                            Style="{StaticResource DangerInlineActionButtonStyle}"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveSecondaryBodyPartCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Entry Placeholder="Equipment" Text="{Binding Equipment}" />
                        <Editor Placeholder="Notes" AutoSize="TextChanges" Text="{Binding Notes}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="Close"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CloseEditorCommand}" />
                            <Button Grid.Column="1"
                                    Text="Save"
                                    Command="{Binding SaveExerciseCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
