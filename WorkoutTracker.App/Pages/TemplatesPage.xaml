<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTracker.App.Pages.TemplatesPage"
             Title="Templates">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Settings" Clicked="OnSettingsClicked" Priority="0" Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,20,20,0" RowSpacing="14">
        <VerticalStackLayout Spacing="4">
            <Label Text="Templates" FontSize="26" FontAttributes="Bold" />
            <Label Text="Browse saved templates first, then open a focused editor when you want to build or revise one." TextColor="{StaticResource Gray200}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" BackgroundColor="{StaticResource Gray950}" Padding="18">
            <VerticalStackLayout Spacing="12">
                <SearchBar Placeholder="Search templates"
                           Text="{Binding SearchText}" />
                <Label Text="{Binding Templates.Count, StringFormat='{}{0} template(s) shown'}"
                       TextColor="{StaticResource Gray200}" />
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Templates}"
                        SelectionMode="None"
                        Margin="0,0,0,20">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource Gray900}" Padding="14" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="{Binding Exercises.Count, StringFormat='{}{0} exercises'}" TextColor="{StaticResource Gray200}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Edit"
                                        Style="{StaticResource InlineActionButtonStyle}"
                                        VerticalOptions="Start"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditTemplateCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                            <Label Text="{Binding Notes}" TextColor="{StaticResource Gray200}" />
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                <Button Grid.Column="0"
                                        Text="Start"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.StartTemplateCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="1"
                                        Text="Delete"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteTemplateCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.RowSpan="3"
                Text="+"
                Style="{StaticResource FloatingActionButtonStyle}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,0,24"
                Command="{Binding NewTemplateCommand}" />

        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsEditorOpen}"
              BackgroundColor="#AA050709"
              Padding="20">
            <Border BackgroundColor="{StaticResource Gray950}"
                    Padding="18"
                    MaximumWidthRequest="560"
                    VerticalOptions="Center">
                <ScrollView>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="{Binding EditorTitle}" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="X"
                                    Style="{StaticResource OverlayDismissButtonStyle}"
                                    Command="{Binding CloseEditorCommand}" />
                        </Grid>
                        <Entry Placeholder="Template name" Text="{Binding TemplateName}" />
                        <Editor Placeholder="Notes" AutoSize="TextChanges" Text="{Binding TemplateNotes}" />
                        <Border BackgroundColor="{StaticResource Gray900}" Padding="14">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Add exercises" FontAttributes="Bold" />
                                <Entry Placeholder="Search exercises"
                                       Text="{Binding ExerciseSearchText}" />
                                <CollectionView ItemsSource="{Binding FilteredExercises}"
                                                SelectionMode="None"
                                                HeightRequest="180">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border BackgroundColor="{StaticResource Gray950}" Padding="10" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                                        <Label Text="{Binding BodyPartsSummary}" TextColor="{StaticResource Gray200}" />
                                                        <Label Text="{Binding Category}" TextColor="{StaticResource Gray300}" FontSize="12" />
                                                    </VerticalStackLayout>
                                                    <Button Grid.Column="1"
                                                            Text="Add"
                                                            Style="{StaticResource InlineActionButtonStyle}"
                                                            VerticalOptions="Center"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddExerciseFromSuggestionCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Included exercises" FontAttributes="Bold" />
                            <CollectionView ItemsSource="{Binding CurrentExercises}"
                                            SelectionMode="None"
                                            HeightRequest="220">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="{StaticResource Gray900}" Padding="10" Margin="0,0,0,8">
                                            <VerticalStackLayout Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                        <Label Text="{Binding ExerciseName}" FontAttributes="Bold" />
                                                        <Label Text="{Binding BodyPart}" TextColor="{StaticResource Gray200}" />
                                                    </VerticalStackLayout>
                                                    <Button Grid.Column="1"
                                                            Text="Remove"
                                                            Style="{StaticResource DangerInlineActionButtonStyle}"
                                                            Command="{Binding RemoveCommand}" />
                                                </Grid>
                                                <Editor Placeholder="Optional notes" AutoSize="TextChanges" Text="{Binding Notes}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="Close"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CloseEditorCommand}" />
                            <Button Grid.Column="1"
                                    Text="Save template"
                                    Command="{Binding SaveTemplateCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
