<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WorkoutTracker.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:WorkoutTracker.App.Pages"
    Title="Workout Tracker"
    FlyoutBehavior="Flyout">
    <Shell.FlyoutHeader>
        <Grid Padding="24,54,24,22"
              BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">
            <VerticalStackLayout Spacing="6">
                <Label Text="Workout Tracker"
                       FontSize="24"
                       FontAttributes="Bold" />
                <Label Text="Sessions, templates, catalog, and history in one place."
                       TextColor="{StaticResource Gray200}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Home">
        <ShellContent
            Title="Home"
            Route="home"
            ContentTemplate="{DataTemplate pages:HomePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Workout Templates">
        <ShellContent
            Title="Templates"
            Route="templates"
            ContentTemplate="{DataTemplate pages:TemplatesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Exercise Catalog">
        <ShellContent
            Title="Catalog"
            Route="catalog"
            ContentTemplate="{DataTemplate pages:ExerciseCatalogPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Workout History">
        <ShellContent
            Title="History"
            Route="history"
            ContentTemplate="{DataTemplate pages:HistoryPage}" />
    </FlyoutItem>
</Shell>
